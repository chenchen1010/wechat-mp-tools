# 仅用于服务方服务器，不能交付给买家。
# 当前实现是单实例共享令牌：第三方交付需每买家独立实例/令牌，且仅配置其自有公众号。
# 多实例可共用同一公网出口IP，但需不同本地端口和独立受保护配置。
PORT=18890
API_TOKEN=your-api-token-here

# 本实例买家的公众号（default仅为实例内别名）
WECHAT_APP_ID=wx...
WECHAT_APP_SECRET=...

# 可选：同一买家拥有的其他账号（不能混入其他买家）
# WECHAT_APP_ID_QWJXQN=wx...
# WECHAT_APP_SECRET_QWJXQN=...
# WECHAT_APP_ID_JSCXBWD=wx...
# WECHAT_APP_SECRET_JSCXBWD=...
