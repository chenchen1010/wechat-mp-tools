# 买家本地配置。由服务方完成该买家公众号绑定后单独提供。
# 先把服务方公网出口 8.153.207.214 加入买家自己公众号的 IP 白名单。
# 勿复用开发者的 env、账号或共享管理令牌。
WECHAT_MP_API_BASE_URL=https://your-buyer-service.example.com/wechat-mp
WECHAT_MP_API_TOKEN=replace-with-buyer-specific-token
WECHAT_MP_API_ACCOUNT_DEFAULT=replace-with-bound-account-alias

# 按需配置买家自己的生图服务；不会因贴图上传自动调用。
# EVOLINK_API_KEY=...
