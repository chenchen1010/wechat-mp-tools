# 微信公众号凭证（默认账号）
WECHAT_APP_ID=wx...
WECHAT_APP_SECRET=...

# 可选：其他公众号账号
# WECHAT_APP_ID_QWJXQN=wx...
# WECHAT_APP_SECRET_QWJXQN=...

# 可选：Evolink 生图
# EVOLINK_API_KEY=...

# ECS 代理配置（推荐，避免 IP 白名单问题）
WECHAT_MP_API_PREFER=1
WECHAT_MP_API_BASE_URL=https://your-server.example.com/wechat-mp
WECHAT_MP_API_TOKEN=...
WECHAT_MP_API_ACCOUNT_DEFAULT=default
